# Cloudflare Worker URL for cloud sharing feature
VITE_WORKER_URL=https://songbook-worker.YOUR_SUBDOMAIN.workers.dev

# Maximum followers per conductor broadcast (must match CONDUCTOR.MAX_FOLLOWERS in songbook-worker/src/config.ts)
VITE_CONDUCTOR_MAX_FOLLOWERS=5
# Cloudflare Turnstile site key (get from Cloudflare Dashboard → Turnstile → Add site)
# Use test key 1x00000000000000000000AA for local dev (always passes)
VITE_TURNSTILE_SITE_KEY=
